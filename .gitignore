# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
build/build/
build/dist/
build/*.spec.bak
dist/
*.spec~

# PyInstaller intermediate (keep build/build.spec and build/make_release.ps1)
# The following are intermediate pyinstaller output dirs:
build/CloneHeroAutoChart/

# Release artifacts (regenerated by scripts, do not commit binaries)
release/
*.exe
!resources/ffmpeg.exe.keep
!resources/ffprobe.exe.keep

# FFmpeg binaries (fetched by build script, too big for git)
resources/ffmpeg.exe
resources/ffprobe.exe

# Runtime / cache / temp
tmp/
*.log
*.tmp
*.cache/
.DS_Store
Thumbs.db

# Secrets / local config
*.secret
secrets.json
settings.local.json
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
desktop.ini

# Project-specific generated reports
core/WAKE_UP_SUMMARY.md
tests/__pycache__/

# Coverage & benchmark artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
tests/.benchmarks/

# Maestri workspace state (per-machine agent sessions)
.maestri/
